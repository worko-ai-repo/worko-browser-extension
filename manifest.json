{
  "manifest_version": 3,
  "name": "Worko Job Matcher",
  "version": "1.0.0",
  "description": "AI-powered job matching extension that helps you find the perfect job opportunities on Naukri, NaukriGulf, and LinkedIn",
  "author": "Worko.ai",
  
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "tabs"
  ],
  
  "host_permissions": [
    "https://www.naukri.com/*",
    "https://www.naukrigulf.com/*",
    "https://www.linkedin.com/*",
    "https://api.worko.ai/*",
    "https://dev-api.worko.ai/*",
    "https://api.dev.worko.work/*",
    "https://api.prod.worko.work/*",
    "https://jobs.dev.worko.work/*",
    "https://worko-dev.auth.ap-south-1.amazoncognito.com/*",
    "https://worko-prod.auth.ap-south-1.amazoncognito.com/*"
  ],
  
  "oauth2": {
    "client_id": "16sh5s2bo3169886fdm8gtp0e4",
    "scopes": ["openid", "email", "profile"]
  },
  
  "action": {
    "default_title": "Worko Job Matcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "96": "icons/96.png",
      "128": "icons/128.png"
    }
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["https://www.naukri.com/*", "https://www.naukrigulf.com/*"],
      "js": ["content-naukri.js"],
      "css": ["content-naukri.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content-linkedin.js"],
      "css": ["content-linkedin.css"],
      "run_at": "document_end"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://www.naukri.com/*", "https://www.naukrigulf.com/*", "https://www.linkedin.com/*"]
    }
  ],
  
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}