{
  "name": "worko-browser-extension",
  "version": "1.0.0",
  "description": "Worko Job Matcher Browser Extension",
  "main": "background/background.js",
  "scripts": {
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "dev": "webpack --mode=development --watch",
    "package:dev": "npm run build:dev && npm run zip:dev",
    "package:store": "npm run build:dev && npm run zip:store",
    "zip:dev": "cd dist && zip -r ../worko-extension-dev.zip . -x '*.map' && cd ..",
    "zip:store": "cd dist && zip -r ../worko-extension-store.zip . -x '*.map' '*.d.ts*' && cd ..",
    "test": "jest",
    "lint": "eslint src/**/*.{js,ts}",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.0",
    "eslint": "^8.0.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.5.0",
    "mini-css-extract-plugin": "^2.7.0",
    "style-loader": "^3.3.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "keywords": [
    "browser-extension",
    "job-matching",
    "worko",
    "naukri",
    "linkedin"
  ],
  "author": "Worko.ai",
  "license": "MIT"
}