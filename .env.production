# Production Environment Configuration
NODE_ENV=production

# Worko API Configuration
WORKO_API_BASE_URL=https://api.worko.ai
WORKO_API_VERSION=v1

# AWS Cognito Configuration (Production)
WORKO_COGNITO_USER_POOL_ID=PROD_USER_POOL_ID_PLACEHOLDER
WORKO_COGNITO_CLIENT_ID=PROD_CLIENT_ID_PLACEHOLDER
WORKO_COGNITO_DOMAIN=https://worko-prod.auth.ap-south-1.amazoncognito.com
WORKO_COGNITO_REGION=ap-south-1

# Extension Configuration
EXTENSION_NAME=Worko Job Matcher
EXTENSION_VERSION=1.0.0

# Feature Flags
ENABLE_DEBUG_LOGGING=false
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_REPORTING=true

# Job Matching Configuration
MAX_JOB_HISTORY=50
DEFAULT_SCORE_THRESHOLD=30